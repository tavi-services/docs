{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tavi Client API",
  "colors": {
    "primary": "#001D56",
    "light": "#C5AAFB",
    "dark": "#001D56"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["overview", "quickstart", "authentication"]
      },
      {
        "group": "Guides",
        "pages": ["sites", "work-orders", "tracking", "errors"]
      },
      {
        "group": "Trust",
        "pages": ["security"]
      },
      {
        "group": "API reference",
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    }
  },
  "fonts": {
    "family": "Instrument Sans"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "redirects": [
    { "source": "/index", "destination": "/overview" },
    { "source": "/api-reference", "destination": "/work-orders" },
    { "source": "/journey", "destination": "/overview" },
    { "source": "/events", "destination": "/tracking" },
    { "source": "/approvals", "destination": "/work-orders" },
    { "source": "/integration-configuration", "destination": "/authentication" }
  ]
}
